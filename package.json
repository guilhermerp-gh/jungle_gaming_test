{
  "name": "distributed-wagering-processor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "APP_ROLE=all bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "bunx --bun eslint . && bun run lint:money",
    "lint:money": "bash scripts/lint-money.sh",
    "typecheck": "tsc --noEmit",
    "migration:create": "bunx --bun mikro-orm migration:create --config src/infrastructure/persistence/mikro-orm/mikro-orm.config.ts",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:pipeline": "bun run lint:money && bun run typecheck && bun test test/unit && bun test test/integration",
    "test:all": "bun test test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2"
  }
}